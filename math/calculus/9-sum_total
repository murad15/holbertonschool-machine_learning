def summation_i_squared(n):
    """
    Calculate sum_{i=1}^{n} i^2 without using loops.

    Args:
        n: stopping condition (must be a positive integer)

    Returns:
        int: the summation value
        None: if n is not a valid number
    """

    # Reject bool explicitly (since bool is a subclass of int)
    if isinstance(n, bool):
        return None

    # Allow int-like floats (e.g., 5.0), but reject non-integer floats
    if isinstance(n, float):
        if not n.is_integer():
            return None
        n = int(n)

    if not isinstance(n, int) or n <= 0:
        return None

    # Closed-form: n(n+1)(2n+1) / 6
    return n * (n + 1) * (2 * n + 1) // 6
